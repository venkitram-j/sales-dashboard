# Copy this file to .env (dev) or .env.production (prod) and fill in real values.
# APP_ENV controls which config profile is loaded: "development" or "production"
APP_ENV=development

# --- Database ---
# Postgres is required: the app relies on native MATERIALIZED VIEW support.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_dev
DB_USER=inventory_app
DB_PASSWORD=change_me
DB_SSLMODE=prefer

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_JSON=false

# --- Ingestion ---
# Rows per batch when bulk-loading Excel data into Postgres via COPY
INGEST_BATCH_SIZE=50000
# Excel file extensions considered for ingestion
INGEST_FILE_EXTENSIONS=.xlsx,.xlsm
