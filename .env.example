# For use with: docker compose -f docker-compose.dev.yml up
# Copy to .env.dev (this file is git-ignored; .env.dev.example is tracked).

# "db" is the Postgres service name in docker-compose.dev.yml, resolved via
# Docker's internal DNS — not localhost, since the app runs in its own container.
export DATABASE_URL=postgresql://sales_user:CHANGE_ME@db:5432/sales_dashboard

# In-container path — matches the volume mount in docker-compose.dev.yml
# (./sample_data on your host -> /data/source_files in the container).
export SOURCE_FOLDER=/home/venkitram/sales_app/SalesReports

export HEADER_ROW=5
export START_COL=B
export COLUMNS_TO_READ="Product Code,Description,Branch,Sales Qty,Pending PO,Admin,Buyer"

export PRODUCT_COL="Product Code"
export DESCRIPTION_COL="Description"
export BRANCH_COL="Branch"
export SALES_COL="Sales Qty"
export PENDING_PO_COL="Pending PO"
export ADMIN_COL="Admin"
export BUYER_COL="Buyer"

export APP_PASSWORD=dev
